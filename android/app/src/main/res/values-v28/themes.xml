<resources>
    <!-- API 28+: video goes edge to edge under display cutouts; the controls keep clear of them (safe drawing insets). -->
    <style name="Theme.StreamForge.Player" parent="Theme.StreamForge">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
